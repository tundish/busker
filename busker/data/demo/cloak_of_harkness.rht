{"seal": 20260829125737, "type": "application/x-python", "path": ["world"]}
# Move the marker to a new path
logger = logging.getLogger(format(marker.parent.path))
context = engine.journal.context(marker.parent.path)
logger.debug(f"Marker context: {context}")

context = engine.journal.context(marker.mark)
logger.debug(f"Handler context: {context}")

logger.info(f"Checking if {heading=} possible")
branches = engine.journal.branches(tuple(marker.mark))
options = {pair[0].curl: pair for pair in branches}
try:
    pair = options[heading[1]]
except KeyError:
    raise Exclamation(f"Can't go {heading[0]}!")

path = pair[1].path
curl = pair[0].curl
jump = marker.move(path, curl=curl)
raise Exclamation(f"All done! {jump}")

